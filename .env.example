# Platform API — salin ke `.env` (jangan commit)
# Acuan: docs/env.md
# Default lokal = mock. DECART_API_KEY baru diisi saat smoke live.

DATABASE_URL=postgresql+psycopg://brand:brand@localhost:5432/brand_tryon
REDIS_URL=redis://localhost:6379/0
TRYON_MODE=mock
DECART_API_KEY=
SESSION_MAX_SECONDS_STUDIO=120
SESSION_MAX_SECONDS_FITTING=300
SESSION_MAX_SECONDS_ECOM=60
SESSION_PAUSE_MAX_SECONDS=86400
PERSON_DETECTION_HARD_GATE=false
QR_ROTATE_SECONDS=60
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=brand-mockups
R2_PUBLIC_BASE_URL=
CF_IMAGES_ACCOUNT_HASH=
SECRET_KEY=change-me-dev-only
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
ENVIRONMENT=development
